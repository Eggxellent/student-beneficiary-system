PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_beneficiary_system
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:4174
# Frontend origin used to build student QR verification URLs; set to the public HTTPS origin in production.
PUBLIC_APP_URL=http://localhost:4174
# Optional: days before an unacknowledged payment is flagged overdue. Unset disables the deadline.
ACKNOWLEDGEMENT_OVERDUE_DAYS=
DUPLICATE_REVIEW_THRESHOLD=0.30
DUPLICATE_HIGH_PRIORITY_THRESHOLD=0.70
ML_REVIEW_SCORE_THRESHOLD=0.50
